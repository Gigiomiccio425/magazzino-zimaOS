# Copia questo file in ".env" e modifica i valori.
# cp .env.example .env

# Nome mostrato nell'interfaccia
APP_NAME=MAGAZZINO

# Chiave firma cookie di sessione. Vuoto = generata e salvata in ./data/.secret_key
SECRET_KEY=

# Fuso orario
TZ=Europe/Rome

# URL pubblico (QR delle etichette, link negli avvisi Discord). Vuoto = indirizzo della richiesta.
PUBLIC_BASE_URL=

# Dominio fisso per le impronte/passkey. Vuoto = dominio da cui apri l'app.
WEBAUTHN_RP_ID=
